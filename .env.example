# Copy this file to .env and fill in the values.

# Port of the production server (`npm start`). Most hosts set this for you.
PORT=3001

# Port of the API during development (`npm run dev`). Vite proxies /api to it.
API_PORT=3001

# Password for the reservations dashboard at /admin.
# Use a long random string. If left empty, the dashboard is disabled.
ADMIN_TOKEN=

# Folder where reservations.json is stored. Point this at a persistent disk in production.
# DATA_DIR=./server/storage

# Set to 1 when running behind a reverse proxy (Render, Railway, Nginx...) so rate limiting sees real client IPs.
# TRUST_PROXY=1
